# Server-only secrets. NEVER commit a real .env and never put these in the frontend.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
DATABASE_URL=            # postgres://user:pass@host:5432/db  (empty = in-memory store, data lost on restart)
PGSSL=                   # set to "disable" for a local Postgres without TLS
ALLOWED_ORIGINS=https://sukidepzai.github.io
ALLOW_ANON=0             # 1 only for local testing without tokens
PORT=2567
